section.section.container.clients
  h2.section__title CLIENTS &amp; KIND WORDS
  p.section__subtitle Some of the teams that trusted us with their brands.

  .clients__grid
    each client in clientsList
      span.clients__logo= client

  .clients__testimonial
    span.clients__quote “
    p.clients__text= testimonialData.text
    .clients__author
      .clients__avatar
        +picture(testimonialData.avatar, testimonialData.author, 72, 72, '36px').clients__avatar-img
      .clients__author-info
        strong.clients__author-name= testimonialData.author
        span.clients__author-role= testimonialData.role
      .clients__dots
        each dot, idx in [0, 1, 2]
          span.clients__dot(class={ 'clients__dot--active': idx === 0 })
