//- Підключення всіх Pug-міксинів
include ../mixins/_btn.pug
include ../mixins/_icon.pug
include ../mixins/_picture.pug
include ../mixins/_work-card.pug

doctype html
html(lang='en')
  head
    block meta
      meta(charset='UTF-8')
      meta(name='viewport', content='width=device-width, initial-scale=1.0')
    block title
      link(
        rel='icon',
        type='image/svg+xml',
        href='data:image/svg+xml,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 32 32\'><rect width=\'32\' height=\'32\' rx=\'6\' fill=\'%23ef5f60\'/><text x=\'50%\' y=\'54%\' dominant-baseline=\'middle\' text-anchor=\'middle\' fill=\'white\' font-family=\'sans-serif\' font-weight=\'bold\' font-size=\'20\'>K</text></svg>'
      )
      title Keepsake
    block styles
      link(rel='stylesheet', href='/src/styles/main.scss')
  body
    //- Прихований SVG-спрайт для векторних іконок
    include ../includes/svg-sprite.pug

    block content

    block scripts
