{
  "name": "vite-pug-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.js",
    "format": "prettier --write \"src/**/*.{pug,scss,js}\" \"*.{js,json,md}\"",
    "lint:css": "stylelint \"src/styles/**/*.scss\"",
    "lint": "npm run lint:css && prettier --check \"src/**/*.{pug,scss,js}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.6.0",
    "@vituum/vite-plugin-pug": "^1.1.0",
    "autoprefixer": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "sass": "^1",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "vite": "8.3.3",
    "vituum": "^1.2.0"
  },
  "lint-staged": {
    "src/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "src/**/*.{pug,js}": [
      "prettier --write"
    ]
  }
}
